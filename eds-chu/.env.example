# Copier ce fichier en .env et remplir les valeurs avant le premier lancement.

# --- RGPD : sel de pseudonymisation ---
PIPELINE_SALT=remplacer_par_une_chaine_aleatoire_longue

# --- Chemins ---
# Chemin absolu vers le dossier source-filestorage (lecture seule)
SOURCE_DIR=/chemin/absolu/vers/source-filestorage
# Chemin absolu vers le dossier lake (copie de travail, ignoré par git)
LAKE_DIR=/chemin/absolu/vers/eds-chu/lake

# --- ClickHouse (compte admin utilisé par le pipeline) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Cloisonnement Gold : comptes ClickHouse dédiés aux connexions Metabase ---
# Créés par le pipeline (step4). Chacun n'a SELECT que sur sa base Gold.
# Générer des valeurs aléatoires, par ex. :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
GOLD_PILOTAGE_PASSWORD=remplacer_par_un_mot_de_passe_aleatoire
GOLD_RECHERCHE_PASSWORD=remplacer_par_un_mot_de_passe_aleatoire


METABASE_URL=http://localhost:3001
METABASE_ADMIN_EMAIL=email_du_compte_admin_metabase
METABASE_ADMIN_PASSWORD=mot_de_passe_du_compte_admin_metabase
METABASE_PILOTE_PASSWORD=mot_de_passe_du_compte_pilote
METABASE_CHERCHEUR_PASSWORD=mot_de_passe_du_compte_chercheur
