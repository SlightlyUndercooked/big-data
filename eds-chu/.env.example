# Copier ce fichier en .env et remplir les valeurs avant le premier lancement.
# Le fichier .env ne doit JAMAIS être commité (il contient le sel RGPD).

# --- RGPD : sel de pseudonymisation ---
# Chaîne aléatoire longue et secrète.
# Changer ce sel invalide TOUS les pseudonymes existants (les jointures cassent).
# En production : stocker dans un coffre-fort (Vault, AWS Secrets Manager...).
PIPELINE_SALT=remplacer_par_une_chaine_aleatoire_longue

# --- Chemins ---
# Chemin absolu vers le dossier source-filestorage (lecture seule)
SOURCE_DIR=/chemin/absolu/vers/source-filestorage
# Chemin absolu vers le dossier lake (copie de travail, ignoré par git)
LAKE_DIR=/chemin/absolu/vers/eds-chu/lake

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
